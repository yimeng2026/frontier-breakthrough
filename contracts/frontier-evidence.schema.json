{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yimeng2026/frontier-breakthrough/blob/main/contracts/frontier-evidence.schema.json",
  "title": "Frontier Evidence Packet",
  "type": "object",
  "required": ["schemaVersion", "asOf", "project", "scope", "items"],
  "properties": {
    "schemaVersion": {"const": 1},
    "asOf": {"type": "string", "format": "date"},
    "project": {"const": "frontier-breakthrough"},
    "scope": {"type": "string", "minLength": 20},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "title", "status", "evidenceClass", "sources", "metrics", "scientificClaim", "limitations", "upstreamContribution", "snapshotFiles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "domain": {"enum": ["math", "chemistry", "physics", "biology"]},
          "title": {"type": "string"},
          "status": {"const": "verified"},
          "evidenceClass": {"enum": ["known_answer_reproduction", "cross_database_check", "local_recomputation"]},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
          "metrics": {"type": "object"},
          "scientificClaim": {"type": "string"},
          "limitations": {"type": "string"},
          "upstreamContribution": {"type": "string"},
          "snapshotFiles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^validation/.+\\.json$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
